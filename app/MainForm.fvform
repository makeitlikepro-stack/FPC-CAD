<?xml version="1.0" encoding="utf-8"?>
<UI caption="FPC-CAD" version="1" position="screenCenter" borderStyle="sizeable" formOnCreate="FormCreate" formOnKeyDown="FormKeyDown">
  <Panel id="root" class="ui-form" width="1200" height="760">
    <Viewport3D id="View" top="0" left="0" width="872" height="734" edgeWidth="1.20000004768372" showEdges="true"/>
    <Panel id="SketchToolbar" top="6" left="163" width="614" height="77" borderRadius="6" backgroundColor="#EDF0F5">
      <Button id="FinishButton" top="3" hint="Finish sketch (Ctrl+Enter)" left="3" text="" width="34" height="34" iconFile="../assets/icons/png/24/finish.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="SelectButton" top="3" hint="Select (S)" left="54" text="" width="34" height="34" iconFile="../assets/icons/png/24/select.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="LineButton" top="3" hint="Line (L)" left="91" text="" width="34" height="34" iconFile="../assets/icons/png/24/line.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="RectButton" top="3" hint="Rectangle (R)" left="128" text="" width="34" height="34" iconFile="../assets/icons/png/24/rect.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="CircleButton" top="3" hint="Circle (C)" left="165" text="" width="34" height="34" iconFile="../assets/icons/png/24/circle.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="ArcButton" top="3" hint="Centre arc (A)" left="202" text="" width="34" height="34" iconFile="../assets/icons/png/24/arc.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="Arc3Button" top="3" hint="3-point arc (T)" left="239" text="" width="34" height="34" iconFile="../assets/icons/png/24/arc3.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="PointButton" top="3" hint="Point (P)" left="276" text="" width="34" height="34" iconFile="../assets/icons/png/24/point.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="DimensionButton" top="3" hint="Dimension (D)" left="327" text="" width="34" height="34" iconFile="../assets/icons/png/24/dimension.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="DistXButton" top="3" hint="Horizontal distance (X)" left="364" text="" width="34" height="34" iconFile="../assets/icons/png/24/dist-x.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="DistYButton" top="3" hint="Vertical distance (Y)" left="401" text="" width="34" height="34" iconFile="../assets/icons/png/24/dist-y.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="UndoButton" top="3" hint="Undo (Ctrl+Z)" left="452" text="" width="34" height="34" iconFile="../assets/icons/png/24/undo.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="RedoButton" top="3" hint="Redo (Ctrl+Y)" left="489" text="" width="34" height="34" iconFile="../assets/icons/png/24/redo.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="NormalViewButton" top="3" hint="Normal to sketch (N)" left="540" text="" width="34" height="34" iconFile="../assets/icons/png/24/normal-view.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="CancelButton" top="3" hint="Cancel (Esc)" left="577" text="" width="34" height="34" iconFile="../assets/icons/png/24/cancel.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="HorizontalButton" top="40" hint="Horizontal (H)" left="3" text="" width="34" height="34" iconFile="../assets/icons/png/24/horizontal.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="VerticalButton" top="40" hint="Vertical (V)" left="40" text="" width="34" height="34" iconFile="../assets/icons/png/24/vertical.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="CoincidentButton" top="40" hint="Coincident" left="77" text="" width="34" height="34" iconFile="../assets/icons/png/24/coincident.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="ParallelButton" top="40" hint="Parallel" left="114" text="" width="34" height="34" iconFile="../assets/icons/png/24/parallel.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="PerpendicularButton" top="40" hint="Perpendicular" left="151" text="" width="34" height="34" iconFile="../assets/icons/png/24/perpendicular.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="EqualButton" top="40" hint="Equal" left="188" text="" width="34" height="34" iconFile="../assets/icons/png/24/equal.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="TangentButton" top="40" hint="Tangent" left="225" text="" width="34" height="34" iconFile="../assets/icons/png/24/tangent.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="ConcentricButton" top="40" hint="Concentric" left="262" text="" width="34" height="34" iconFile="../assets/icons/png/24/concentric.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="MidpointButton" top="40" hint="Midpoint" left="299" text="" width="34" height="34" iconFile="../assets/icons/png/24/midpoint.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="OnObjectButton" top="40" hint="On object" left="336" text="" width="34" height="34" iconFile="../assets/icons/png/24/on-object.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="SymmetricButton" top="40" hint="Symmetric" left="373" text="" width="34" height="34" iconFile="../assets/icons/png/24/symmetric.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Button id="FixButton" top="40" hint="Fix" left="410" text="" width="34" height="34" iconFile="../assets/icons/png/24/fix.png" iconSize="24" iconPosition="center" backgroundColor="#EEEEEE"/>
      <Panel id="ActiveToolMark" top="33" left="58" width="26" height="3" borderRadius="1" backgroundColor="#0078D6"/>
    </Panel>
    <Edit id="DrawValueEdit" top="120" left="300" width="170" height="28" placeholder="length, angle, Enter"/>
    <Panel id="SidePanel" top="0" left="872" width="328" height="734" backgroundColor="#292B30">
      <Label id="TitleLabel" top="10" left="12" text="Plate with 6 holes" width="236" height="26"/>
      <Label id="RadiusLabel" top="44" left="12" text="Hole radius: 4.00 mm" width="236" height="24"/>
      <Slider id="RadiusSlider" top="70" left="12" value="4" width="236" height="28" maximum="7" minimum="1" eventOnChange="RadiusSliderChange"/>
      <Label id="SelectedLabel" top="108" left="12" text="Selected: -" width="236" height="24"/>
      <Label id="HoverLabel" top="132" left="12" text="Hover: -" width="236" height="24"/>
      <Label id="RecomputeLabel" top="166" left="12" text="Recompute: -" width="236" height="24"/>
      <Label id="ComputedLabel" top="190" left="12" text="" width="236" height="24"/>
      <Label id="MeshesLabel" top="202" left="12" text="" width="236" height="24"/>
      <Label id="SyncLabel" top="238" left="12" text="" width="236" height="24"/>
      <GroupBox id="SketchGroup" top="276" left="8" width="312" height="310" caption="Sketch">
        <Button id="NewSketchButton" top="8" hint="New sketch on the XY plane" left="8" text="New sketch" width="134" height="30" iconFile="../assets/icons/png/20/new-sketch.png" iconSize="20" textColor="#434343" backgroundColor="#FFFFFF"/>
        <Button id="EditSketchButton" top="8" hint="Edit the sketch of the selected body (or the last one)" left="152" text="Edit sketch" width="130" height="30" iconFile="../assets/icons/png/20/edit-sketch.png" iconSize="20" textColor="#434343" backgroundColor="#FFFFFF"/>
        <Label id="RelationsLabel" top="48" left="8" text="Relations and dimensions" width="224" height="22"/>
        <ListBox id="ConstraintList" top="70" left="8" width="274" height="120"/>
        <Edit id="ValueEdit" top="200" left="8" width="100" height="30" placeholder="value, Enter = set"/>
        <Button id="SetButton" top="200" hint="Set the dimension to the value" left="114" text="Set" width="56" height="30"/>
        <Button id="DeleteButton" top="200" hint="Delete the selected relation (Delete)" left="176" text="Delete" width="56" height="30"/>
        <Label id="DofLabel" top="238" left="8" text="DOF -" width="224" height="24"/>
      </GroupBox>
    </Panel>
    <Label id="StatusLabel" top="734" left="8" text="" width="1184" height="26" textColor="#D9DEE6"/>
  </Panel>
</UI>
