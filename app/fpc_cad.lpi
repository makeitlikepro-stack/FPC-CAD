<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="FPC-CAD"/>
      <Scaled Value="True"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <RequiredPackages>
      <Item>
        <PackageName Value="LazOpenGLContext"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="fpc_cad.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <!-- Built into the repo root: external/occt_bridge resolves next to the exe. -->
      <Filename Value="../fpc_cad"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <!-- Engine: sibling checkout ../FPC-OpenGL-UI-Engine at engine/ENGINE_REF.txt. -->
      <OtherUnitFiles Value="../src/config;../src/core;../src/occt;../src/features;../src/sketch;../src/view;../src/app;../../FPC-OpenGL-UI-Engine/src/core;../../FPC-OpenGL-UI-Engine/src/math;../../FPC-OpenGL-UI-Engine/src/buffers;../../FPC-OpenGL-UI-Engine/src/ecs;../../FPC-OpenGL-UI-Engine/src/effects;../../FPC-OpenGL-UI-Engine/src/shaders;../../FPC-OpenGL-UI-Engine/src/text;../../FPC-OpenGL-UI-Engine/src/cad;../../FPC-OpenGL-UI-Engine/src/compute;../../FPC-OpenGL-UI-Engine/src/resources;../../FPC-OpenGL-UI-Engine/src/rendering;../../FPC-OpenGL-UI-Engine/src/ui"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Parsing>
      <SyntaxOptions>
        <SyntaxMode Value="ObjFPC"/>
      </SyntaxOptions>
    </Parsing>
    <CodeGeneration>
      <Optimizations>
        <OptimizationLevel Value="2"/>
      </Optimizations>
    </CodeGeneration>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
      </Debugging>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
</CONFIG>
