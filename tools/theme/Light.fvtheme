; FPC Visual IDE theme (built-in, read-only: save a copy to change it)
; Light theme.
name = Light

[palette]
chrome = #F3F3F3
surface = #FFFFFF
popup = #FFFFFF
editor = #FFFFFF
tabbar = #E8E8E8
canvas = #E4E4E4
row-alt = #F7F7F7
category = #EAEAEA
hover = #E2E4E8
pressed = #D4D7DD
selection = #CDE3F7
accent = #5B9BD5
accent-hover = #4A8AC4
accent-pressed = #3A78B0
focus = #0F6CBD
line = #DCDCDC
border = #C8C8C8
popup-border = #C2C2C2
button-border = #B4B4B4
text = #242424
text-strong = #000000
guide = #D6247A
text-muted = #5E5E5E
text-disabled = #9A9A9A
overlay = #000000
shadow = #000000

[override]
editor.bookmark = #1A85FF
editor.bracket-border = #B9B9B9
editor.caret = #000000
editor.current-line = #0000000A
editor.error = #E51400
editor.find-match-current = #A8AC94
editor.fold-marker = #424242
editor.fold-placeholder = #808080
editor.folded-line = #ADD6FF4D
editor.foreground = #000000
editor.gutter-active = #0B216F
editor.gutter-foreground = #237893
editor.indent-guide = #D3D3D3
editor.indent-guide-active = #939393
editor.info = #1A85FF
editor.minimap-slider = #64646433
editor.ruler = #D3D3D3
editor.secondary-caret = #00000099
editor.selection = #ADD6FF
editor.selection-inactive = #E5EBF1
editor.selection-match = #ADD6FF80
editor.warning = #BF8803
editor.whitespace = #33333333
editor.widget-foreground = #616161
syntax.attribute = #E50000
syntax.attrvalue = #0000FF
syntax.builtin = #795E26
syntax.char = #A31515
syntax.color = #0451A5
syntax.comment = #008000
syntax.constant = #0000FF
syntax.doccomment = #008000 italic
syntax.entity = #EE0000
syntax.escape = #EE0000
syntax.function = #795E26
syntax.gcode-axis = #001080
syntax.gcode-g = #0000FF bold
syntax.gcode-line = #237893
syntax.gcode-m = #AF00DB bold
syntax.gcode-param = #795E26
syntax.identifier = #001080
syntax.invalid = #CD3131
syntax.keyword = #0000FF
syntax.keyword2 = #AF00DB
syntax.label = #267F99
syntax.number = #098658
syntax.operator = #000000
syntax.preprocessor = #AF00DB
syntax.property = #E50000
syntax.punctuation = #000000
syntax.regex = #811F3F
syntax.selector = #800000
syntax.string = #A31515
syntax.tag = #800000
syntax.text = #000000
syntax.type = #267F99
syntax.unit = #098658
syntax.variable = #0070C1
